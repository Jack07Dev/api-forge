{
  "name": "api-platform-api",
  "private": true,
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.development --import tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:dev": "node --env-file=.env.development dist/server.js",
    "test": "npm run test:node && npm run test:vitest",
    "test:node": "node --env-file=.env.test --import tsx --test $(find src/tests -maxdepth 1 -name '*.test.ts' ! -name 'api-publishing-abort.test.ts' -print)",
    "test:vitest": "NODE_ENV=test vitest run src/tests/api-publishing-abort.test.ts",
    "test:publishing-abort": "npm run test:vitest",
    "test:transaction": "node --env-file=.env.test --import tsx --test src/tests/api-publishing-transaction.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}